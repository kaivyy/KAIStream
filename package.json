{
  "name": "kaistream",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KAIStream: Railway Live Tracking Indonesia (Pulau Jawa) berbasis simulasi jadwal",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:data": "python3 scripts/build_java_data.py",
    "sync:data": "bash scripts/auto_sync.sh",
    "sync:refresh": "python3 scripts/build_java_data.py --refresh --mirror-dir dist/data"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
